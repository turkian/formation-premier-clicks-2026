---
/**
 * Gabarit d'une fiche de référence.
 *
 * Le contenu vient d'un fichier Markdown de la collection `fiches`. Ajouter une
 * fiche au site coûte donc exactement un fichier : la route et l'index se
 * peuplent d'eux-mêmes.
 */
import Base from '../layouts/Base.astro';
import { lien } from '../lib/lien';
import { typo } from '../lib/typo';
import '../styles/carrefour.css';
import '../styles/fiche.css';

interface Props {
  titre: string;
  sousTitre?: string;
  seance?: number;
  colonnes?: 'une' | 'deux';
  densite?: 'normale' | 'serree';
}

const { titre, sousTitre, seance, colonnes = 'deux', densite = 'normale' } = Astro.props;
---

<Base titre={titre} description={sousTitre} genre="genre-fiche">
  <div class="fiche" id="contenu">
    <nav class="fil sans-impression">
      <a href={lien('/')}>Premiers clics</a> <span>·</span>
      <a href={lien('/')}>Fiches</a> <span>·</span>
      <span set:html={typo(titre)} />
    </nav>

    <header class="fiche-entete">
      <p class="surtitre">
        Fiche de référence{seance ? typo(` · séance ${seance}`) : ''}
      </p>
      <h1 set:html={typo(titre)} />
      {sousTitre && <p class="sous-titre" set:html={typo(sousTitre)} />}
    </header>

    <div class="fiche-corps" data-colonnes={colonnes} data-densite={densite}>
      <slot />
    </div>

    <footer class="fiche-pied">
      <span set:html={typo('Premiers clics — formation photo du club')} />
      <span class="sans-impression">
        <a href={lien('/')}>Toutes les fiches</a>
      </span>
    </footer>
  </div>
</Base>
