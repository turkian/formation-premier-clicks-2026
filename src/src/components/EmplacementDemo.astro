---
/**
 * Un emplacement de photographie de démonstration.
 *
 * Tant que l'image n'existe pas, l'emplacement affiche **sa propre consigne de
 * prise de vue** — jamais une image brisée, jamais un cadre vide, jamais une
 * erreur. C'est ce qui rend les trois leçons projetables avant qu'une seule des
 * quarante-cinq photographies ait été prise, et c'est aussi la liste de courses
 * de l'animateur, affichée à l'endroit exact où elle manque.
 *
 * Quand le fichier arrive, il remplace la consigne sans qu'aucune autre
 * modification soit nécessaire.
 */
import { asset } from '../lib/lien';
import { typo } from '../lib/typo';
import { trouverImage } from '../lib/demos';

interface Props {
  /** Identifiant de l'emplacement : il donne le nom de fichier attendu. */
  id: string;
  /** Nom de fichier, seulement s'il s'écarte de la règle `<id>.jpg`. */
  fichier?: string;
  specification: string;
  alt?: string;
  valeur?: string;
  priorite?: string;
  /**
   * Cadrage de repos : cadre la vue de repos sur ce point à ce grossissement
   * plutôt que de montrer le cadre entier. Absent, la vue de repos montre le
   * cadre entier, comme avant.
   */
  cadrage?: { point: [number, number]; zoom: number };
}

const { id, fichier, specification, alt, valeur, priorite, cadrage } = Astro.props;
const image = await trouverImage(id, fichier);
const texteAlt = alt ?? specification;
const styleCadrage = cadrage
  ? `transform: scale(${cadrage.zoom}); transform-origin: ${cadrage.point[0]}% ${cadrage.point[1]}%;`
  : undefined;
---

<figure class="emplacement" data-presente={image ? '' : undefined}>
  {image ? (
    <div class="marco">
      <button type="button" class="declencheur" data-ouvrir aria-label={`Agrandir la photographie : ${texteAlt}`}>
        <img src={asset(`/demos/${image}`)} alt={texteAlt} loading="lazy" style={styleCadrage} />
      </button>
    </div>
  ) : (
    <div class="a-photographier">
      <p class="mention">Photographie à préparer</p>
      <p class="specification" set:html={typo(specification)} />
      {priorite === 'essentiel' && (
        <p class="priorite" aria-label="Photographie essentielle">Essentielle</p>
      )}
    </div>
  )}
  {valeur && <figcaption class="etiquette-repos" set:html={typo(valeur)} />}
  {image && (
    <dialog class="agrandi" data-dialogue aria-label={texteAlt}>
      <button type="button" class="fermeture" data-fermer aria-label="Réduire la photographie">
        <img src={asset(`/demos/${image}`)} alt={texteAlt} />
      </button>
      {valeur && <figcaption set:html={typo(valeur)} />}
    </dialog>
  )}
</figure>

<style>
  .emplacement {
    margin: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--pas);
    min-height: 0;
  }

  /* Le cadre de repos : ce qui recadre, c'est le `transform` posé sur l'image
     elle-même (voir le style en ligne) ; ce conteneur ne fait que le rogner. */
  .marco {
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--rayon);
  }

  .declencheur {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .marco img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    min-height: 0;
  }

  /* L'emplacement vide est un objet fini, pas une avarie : il se lit de loin et
     ne casse pas la composition de l'écran. */
  .a-photographier {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.4em;
    text-align: center;
    padding: var(--pas);
    border: 2px dashed var(--trait-fort);
    border-radius: var(--rayon);
    background: var(--fond-2);
    min-height: 0;
    height: 100%;
    /* La consigne reste dans son cadre : un emplacement vide est un objet fini,
       pas du texte qui déborde sur l'écran voisin. Le débordement est alors
       détectable, et la vérification de projection le signale. */
    overflow: hidden;
  }

  .mention {
    font-size: var(--t-etiquette);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texte-3);
    margin: 0;
  }

  .specification {
    font-size: calc(var(--t-corps) * 0.86);
    line-height: 1.3;
    color: var(--texte);
    font-weight: var(--graisse-appui);
    margin: 0;
    max-width: 26ch;
  }

  /* Plusieurs séries sur un même écran : chaque rangée est basse, la consigne
     s'y adapte plutôt que de déborder. */
  @media (min-width: 60rem) and (max-height: 56rem) {
    .specification { font-size: calc(var(--t-corps) * 0.74); }
    .mention { font-size: calc(var(--t-etiquette) * 0.86); }
  }

  .priorite {
    margin: 0;
    font-size: calc(var(--t-aparte) * 0.88);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent-sourd);
    border-radius: 999px;
    padding: 0.05em 0.6em;
  }

  /* Sur un écran qui porte deux séries, chaque cadre est bas : la mention de
     priorité s'efface au profit de la consigne, qui est ce dont l'animateur a
     besoin pour préparer la photo. */
  @media (min-width: 60rem) and (max-height: 56rem) {
    .a-photographier { gap: 0.25em; }
    .priorite { font-size: calc(var(--t-aparte) * 0.78); }
  }

  figcaption {
    font-size: var(--t-aparte);
    color: var(--texte-2);
    text-align: center;
    font-weight: var(--graisse-appui);
  }

  /* L'étiquette de repos reste hors de vue tant que personne ne pointe ou ne
     s'attarde sur l'image : la vue de repos reste aussi dégagée que le cadrage
     la rend, et l'étiquette demeure disponible sur demande (`:hover` couvre la
     souris, `:focus-within` couvre le clavier — aucun script requis). */
  .etiquette-repos {
    visibility: hidden;
  }
  .emplacement:hover .etiquette-repos,
  .emplacement:focus-within .etiquette-repos {
    visibility: visible;
  }

  /* La photographie agrandie : plein cadre, au-dessus de l'écran assombri. */
  .agrandi {
    max-width: min(92vw, 1400px);
    max-height: 90vh;
    padding: var(--pas-2);
    border: none;
    border-radius: var(--rayon-2);
    background: var(--fond-2);
  }

  .agrandi::backdrop {
    background: rgba(0, 0, 0, 0.8);
  }

  .agrandi .fermeture {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .agrandi img {
    display: block;
    max-width: 100%;
    max-height: 80vh;
    width: auto;
    height: auto;
    margin: 0 auto;
    border-radius: var(--rayon);
  }

  .agrandi figcaption {
    padding-top: var(--pas);
  }
</style>

<script>
  /**
   * Agrandissement d'une photographie de démonstration.
   *
   * Le natif `<dialog>` donne l'échappement par Escape, l'empilement
   * au-dessus du reste de l'écran et le piégeage du focus sans rien coder de
   * ça à la main. Le script se limite à l'ouvrir et à le fermer.
   */
  for (const figure of document.querySelectorAll<HTMLElement>('.emplacement')) {
    demarrer(figure);
  }

  function demarrer(figure: HTMLElement) {
    const ouvrir = figure.querySelector<HTMLButtonElement>('[data-ouvrir]');
    const dialogue = figure.querySelector<HTMLDialogElement>('[data-dialogue]');
    const fermer = figure.querySelector<HTMLButtonElement>('[data-fermer]');
    if (!ouvrir || !dialogue) return;

    ouvrir.addEventListener('click', () => dialogue.showModal());
    fermer?.addEventListener('click', () => dialogue.close());

    // Cliquer sur le fond assombri (le `::backdrop`) ferme aussi : seul un
    // clic directement sur le `<dialog>` lui-même, jamais sur son contenu,
    // atteint cette cible.
    dialogue.addEventListener('click', (evenement) => {
      if (evenement.target === dialogue) dialogue.close();
    });
  }
</script>
