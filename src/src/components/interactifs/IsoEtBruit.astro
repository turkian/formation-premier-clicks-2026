---
/**
 * ISO et bruit — le bruit vient de la lumière, l'ISO le rend visible.
 *
 * Deux entrées, et pas une de plus :
 *   - **la lumière captée** — ce que l'ouverture, la vitesse et la scène ont
 *     laissé entrer. C'est elle seule qui décide du bruit : moins de lumière,
 *     plus de bruit, quel que soit l'ISO ;
 *   - **le volume, l'ISO** — qui amplifie ce qui a été capté. Il décide de la
 *     luminosité de l'image, avec la lumière, jamais du bruit.
 *
 * D'où la seule chose que le composant ne doit jamais montrer : une image plus
 * propre parce que l'ISO a baissé. À lumière égale, baisser l'ISO assombrit
 * l'image et cache son bruit dans l'ombre ; il ne l'enlève pas.
 *
 * Le modèle, en crans : l'exposition `E = lumière + volume − 6`. À `E = 0`,
 * l'image est bien exposée ; en dessous, trop sombre ; au-dessus, trop claire.
 * Pour chaque lumière, un seul ISO expose correctement.
 *
 * Le composant ne simule plus la vitesse : le flou de bougé est montré par la
 * série de photographies de l'écran suivant, avec de vraies images.
 */
import { typo } from '../../lib/typo';
import '../../styles/interactif.css';
---

<div class="composant" data-iso>
  <div class="commandes">
    <div class="levier">
      <div class="etiquette">
        <span>La lumière captée</span>
        <output data-sortie="lumiere"></output>
      </div>
      <input type="range" data-levier="lumiere" min="0" max="6" step="1" aria-label="Lumière captée" />
    </div>

    <div class="levier" data-reglage>
      <div class="etiquette">
        <span>Le volume — l'ISO <span class="marque-reglage">un réglage</span></span>
        <output data-sortie="iso"></output>
      </div>
      <input type="range" data-levier="iso" min="0" max="6" step="1" aria-label="ISO" />
    </div>

    <p class="refus" style="color:var(--texte-2)" set:html={typo(
      'Baissez l’ISO : l’image s’assombrit, elle ne devient pas plus propre. Pour moins de bruit, il faut plus de lumière.',
    )} />
  </div>

  <div class="visuel">
    <div class="lecture">
      <div class="bande" data-sortie="verdict"></div>
    </div>

    <svg class="scene-svg" viewBox="0 0 640 260" role="img" data-scene-iso
         aria-label="La même scène : sa luminosité suit la lumière et l'ISO, son bruit suit la lumière captée">
      <defs>
        <filter id="grain-iso" x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.6" numOctaves="2" seed="3" result="bruit" />
          <feColorMatrix in="bruit" type="saturate" values="0.7" />
        </filter>
      </defs>

      <rect x="0" y="0" width="640" height="260" fill="#8a94a3" />
      <rect x="60" y="60" width="180" height="150" rx="8" fill="#b4bdca" />
      <circle cx="420" cy="120" r="58" fill="#d7a86e" />
      <rect x="380" y="176" width="80" height="60" rx="8" fill="#6f7a8a" />
      <rect x="500" y="90" width="90" height="120" rx="6" fill="#9aa6b6" />

      <!-- Le bruit : il ne dépend que de la lumière captée. -->
      <rect x="0" y="0" width="640" height="260" filter="url(#grain-iso)" data-grain style="mix-blend-mode:screen" />
      <!-- La luminosité : l'obscurité recouvre l'image et son bruit ensemble —
           une image sombre cache son bruit, elle ne l'enlève pas. -->
      <rect x="0" y="0" width="640" height="260" fill="#000" data-sombre />
      <rect x="0" y="0" width="640" height="260" fill="#fff" data-clair />
    </svg>

    <div class="lecture" aria-live="polite">
      <div class="sens" data-sortie="jugement"></div>
      <div class="limites" data-sortie="indice"></div>
    </div>
  </div>
</div>

<style>
  [data-iso] .levier output { white-space: nowrap; }
</style>

<script>
  import { typo } from '../../lib/typo';

  /** Sept crans, nommés sans chiffres : on parle de lumière, pas de diaphragmes. */
  const LUMIERES = ['très peu', 'peu', 'assez peu', 'moyenne', 'assez', 'bonne', 'beaucoup'];
  const ISOS = [100, 200, 400, 800, 1600, 3200, 6400];
  /** `E = lumière + volume − K` : à lumière maximale, ISO 100 expose juste. */
  const K = 6;

  for (const racine of document.querySelectorAll<HTMLElement>('[data-iso]')) demarrer(racine);

  function demarrer(racine: HTMLElement) {
    const etat = { lumiere: 1, iIso: 2 };
    const q = <T extends Element>(s: string) => racine.querySelector<T>(s)!;

    racine.addEventListener('input', (e) => {
      const c = e.target as HTMLInputElement;
      if (c.dataset.levier === 'lumiere') etat.lumiere = Number(c.value);
      if (c.dataset.levier === 'iso') etat.iIso = Number(c.value);
      rendre();
    });

    const isoTexte = (i: number) => `ISO ${ISOS[i]!.toLocaleString('fr-CA')}`;

    function rendre() {
      q<HTMLInputElement>('[data-levier="lumiere"]').value = String(etat.lumiere);
      q<HTMLInputElement>('[data-levier="iso"]').value = String(etat.iIso);
      q('[data-sortie="lumiere"]').textContent = LUMIERES[etat.lumiere]!;
      q('[data-sortie="iso"]').textContent = typo(isoTexte(etat.iIso));

      const E = etat.lumiere + etat.iIso - K;

      // Le bruit suit la lumière captée, et elle seule.
      const bruit = (K - etat.lumiere) / K;
      q('[data-grain]').setAttribute('opacity', (bruit * 0.95).toFixed(2));

      // La luminosité suit l'exposition. Chaque cran sous la bonne exposition
      // assombrit l'image — et son bruit avec elle.
      const ecart = (n: number) => 1 - Math.pow(2, -0.6 * n);
      q('[data-sombre]').setAttribute('opacity', E < 0 ? ecart(-E).toFixed(2) : '0');
      q('[data-clair]').setAttribute('opacity', E > 0 ? (ecart(E) * 0.85).toFixed(2) : '0');

      let verdict: string;
      let jugement: string;
      if (E < 0) {
        verdict = 'Trop sombre.';
        jugement =
          etat.lumiere <= 3
            ? "Le bruit n'a pas disparu : il se cache dans l'ombre. Éclaircir la photo plus tard le fera revenir. Montez le volume."
            : 'Il y a assez de lumière : montez le volume, sans crainte.';
      } else if (E > 0) {
        verdict = 'Trop claire.';
        jugement = 'Le volume est trop haut pour cette lumière. Baissez l’ISO.';
      } else {
        verdict = 'Bien exposée.';
        jugement =
          etat.lumiere <= 2
            ? 'Et bruitée : il manquait de lumière. Le volume a rendu visible le bruit — il était déjà là.'
            : etat.lumiere >= 5
              ? 'Et propre : beaucoup de lumière captée, presque pas de bruit.'
              : 'Un peu de bruit : il manquait encore un peu de lumière.';
      }

      q('[data-sortie="verdict"]').textContent = verdict;
      q('[data-sortie="jugement"]').textContent = typo(jugement);
      q('[data-sortie="indice"]').textContent = typo(
        `Avec cette lumière, l'ISO qui expose bien : ${isoTexte(K - etat.lumiere)}.`,
      );
    }

    rendre();
  }
</script>
