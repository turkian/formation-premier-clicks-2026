---
/**
 * L'index des blocs.
 *
 * Une soirée déborde toujours. L'animateur doit pouvoir sauter directement à un
 * bloc sans traverser douze écrans devant la salle — c'est la seule commande de
 * navigation qui existe pour cette raison-là, et pas pour le confort.
 */
import { lien } from '../lib/lien';
import { typo } from '../lib/typo';

interface Props {
  lecon: any;
  blocCourant: string;
}

const { lecon, blocCourant } = Astro.props;
---

<dialog class="index-blocs" data-index-blocs>
  <div class="dedans">
    <h2 set:html={typo(`Séance ${lecon.numero} — ${lecon.titre}`)} />
    <ol>
      {lecon.blocs.map((bloc: any) => (
        <li>
          <a
            href={lien(`/lecons/${lecon.numero}/${bloc.id}/${bloc.ecrans[0].id}`)}
            aria-current={bloc.id === blocCourant ? 'true' : undefined}
          >
            <span set:html={typo(bloc.titre)} />
            {bloc.resume && <span class="resume" set:html={typo(bloc.resume)} />}
          </a>
        </li>
      ))}
    </ol>
    <p style="margin-top:var(--pas-2);font-size:0.86rem;color:var(--texte-3)">
      <kbd>←</kbd> <kbd>→</kbd> pour naviguer · <kbd>i</kbd> pour cet index ·
      <kbd>f</kbd> pour le plein écran · <kbd>Échap</kbd> pour fermer
    </p>
  </div>
</dialog>
