---
/**
 * Déclarations `@font-face` de la police auto-hébergée.
 *
 * Elles vivent dans un composant plutôt que dans `base.css` parce que l'URL
 * d'un fichier de `public/` doit être préfixée par le chemin de base du dépôt
 * (`/formation-premier-clicks-2026/`) : une feuille CSS statique ne peut pas
 * le faire, `asset()` le fait.
 *
 * Inter : hauteur d'x élevée, chiffres sans ambiguïté, vraie plage de graisses
 * variables, couverture complète des accents français et des guillemets « »,
 * capitales accentuées comprises (décision D10).
 */
import { asset } from '../lib/lien';

const latin =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const latinEtendu =
  'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF';

const faces = [
  { fichier: 'inter-latin-wght-normal.woff2', style: 'normal', plage: latin },
  { fichier: 'inter-latin-ext-wght-normal.woff2', style: 'normal', plage: latinEtendu },
  { fichier: 'inter-latin-wght-italic.woff2', style: 'italic', plage: latin },
  { fichier: 'inter-latin-ext-wght-italic.woff2', style: 'italic', plage: latinEtendu },
];

const css = faces
  .map(
    (f) => `@font-face{font-family:'Inter Variable';font-style:${f.style};font-display:swap;font-weight:100 900;src:url('${asset(
      `/polices/${f.fichier}`,
    )}') format('woff2-variations');unicode-range:${f.plage};}`,
  )
  .join('');
---

<link
  rel="preload"
  as="font"
  type="font/woff2"
  href={asset('/polices/inter-latin-wght-normal.woff2')}
  crossorigin
/>
<style is:inline set:html={css}></style>
