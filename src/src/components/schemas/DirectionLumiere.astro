---
/**
 * Les quatre directions de lumière.
 *
 * Le geste le plus rentable de la photographie tient en deux pas de côté ; le
 * schéma montre les quatre positions autour d'un même sujet pour que « bouger »
 * cesse d'être une abstraction.
 *
 * L'appareil reste toujours droit (voir AppareilPhoto.astro) ; sa position est
 * calculée en coordonnées polaires autour du sujet, à la même place que
 * l'ancien rectangle pivoté occupait — seul le dessin change, pas la
 * disposition des quatre positions.
 */
import Sujet from './pieces/Sujet.astro';
import SourceLumiere from './pieces/SourceLumiere.astro';
import AppareilPhoto from './pieces/AppareilPhoto.astro';
import { traitLumiere, traitVisee, pointeVisee } from './pieces/traits.ts';

const POSITIONS = [
  { angle: 180, nom: 'frontale', note: 'plate, sans relief' },
  { angle: 270, nom: 'latérale', note: 'le relief apparaît' },
  { angle: 0, nom: 'contre-jour', note: 'un contour lumineux' },
  { angle: 90, nom: 'du dessus', note: 'des ombres dures', sourceEnHaut: true },
];

const RAYON_APPAREIL = 45;
const COLONNES = 2;
const LARGEUR_CELLULE = 320;
const HAUTEUR_CELLULE = 220;
const LARGEUR_TOTALE = COLONNES * LARGEUR_CELLULE;
const HAUTEUR_TOTALE = (POSITIONS.length / COLONNES) * HAUTEUR_CELLULE + 16;
---
<svg viewBox={`0 0 ${LARGEUR_TOTALE} ${HAUTEUR_TOTALE}`} role="img" style="width:100%;height:auto"
     aria-label="Quatre positions du photographe autour d'un sujet éclairé par une fenêtre, en grille 2 sur 2">
  {POSITIONS.map((position, i) => {
    const colonne = i % COLONNES;
    const ligne = Math.floor(i / COLONNES);
    const cx = LARGEUR_CELLULE / 2 + colonne * LARGEUR_CELLULE;
    const decalageY = ligne * HAUTEUR_CELLULE;
    const sujetX = cx;
    const sujetY = 96 + decalageY;
    const rad = (position.angle * Math.PI) / 180;
    const camX = sujetX + RAYON_APPAREIL * Math.cos(rad);
    const camY = sujetY + RAYON_APPAREIL * Math.sin(rad);

    /**
     * La fenêtre reste au même endroit dans les trois premiers cas — c'est le
     * point pédagogique : la lumière n'a pas bougé, le photographe oui. « Du
     * dessus » ne peut pas se montrer ainsi : une fenêtre fixée sur le côté ne
     * peut jamais paraître au-dessus du sujet. Ce seul cas déplace donc la
     * source au-dessus, en éclairage zénithal, pour que le trait de lumière
     * tombe réellement d'en haut.
     */
    const fenetre = position.sourceEnHaut
      ? { x: sujetX - 32, y: 26 + decalageY, largeur: 64, hauteur: 16 }
      : { x: cx - 62, y: 26 + decalageY, largeur: 18, hauteur: 80 };
    const traitDeLumiere = position.sourceEnHaut
      ? { x1: sujetX, y1: fenetre.y + fenetre.hauteur, x2: sujetX, y2: sujetY - 18 }
      : { x1: fenetre.x + fenetre.largeur, y1: fenetre.y + 40, x2: sujetX - 18, y2: sujetY };

    return (
      <g>
        <SourceLumiere {...fenetre} etiquette="fenêtre" />
        <line {...traitDeLumiere} {...traitLumiere} />
        <line x1={camX} y1={camY} x2={sujetX} y2={sujetY} {...traitVisee} />
        <path d={pointeVisee(sujetX, sujetY, position.angle + 180)} fill="var(--texte-3)" />
        <Sujet x={sujetX} y={sujetY} />
        <AppareilPhoto x={camX} y={camY} />
        <text x={cx} y={184 + decalageY} text-anchor="middle" font-size="15" fill="var(--texte)">{position.nom}</text>
        <text x={cx} y={204 + decalageY} text-anchor="middle" font-size="12" fill="var(--texte-3)">{position.note}</text>
      </g>
    );
  })}
</svg>
