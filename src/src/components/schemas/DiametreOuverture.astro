---
/**
 * La division, posée : focale ÷ nombre `f` = le diamètre réel.
 *
 * Le dessin sert de support statique quand le composant interactif serait de
 * trop — dans un panneau de concept, à côté du texte qui l'explique.
 *
 * Deux modes, une seule échelle — calculée ici, puis confiée au dessin :
 *
 *   - `division` (par défaut) — la division écrite sous chaque disque ;
 *   - `lumiere` — le même dessin lu comme une quantité de lumière : un axe
 *     « plus de lumière ↔ moins de lumière », le sens du chiffre `f` écrit en
 *     toutes lettres, et **aucun chiffre de lumière** — ni division, ni rapport,
 *     ni diaphragme. La surface du disque porte déjà le message.
 *
 * Un mode inconnu interrompt la construction, comme un nom de schéma erroné
 * dans le registre : mieux vaut un échec au build qu'un écran projeté faux.
 */
import { diametre } from '../../lib/profondeur-de-champ';
import DisquesDivision from './pieces/DisquesDivision.astro';
import DisquesLumiere from './pieces/DisquesLumiere.astro';

const MODES = ['division', 'lumiere'] as const;

interface Props {
  focale?: number;
  ouvertures?: number[];
  mode?: (typeof MODES)[number];
  /**
   * Mode `lumiere` seulement : une photographie de démonstration par ouverture,
   * dans le même ordre que `ouvertures` — la même scène, exposée selon le trou.
   */
  photos?: string[];
}
const { focale = 50, ouvertures = [2, 4, 5.6, 16], mode = 'division', photos } = Astro.props;
if (!MODES.includes(mode)) {
  throw new Error(
    `Le mode « ${mode} » du schéma « diametre-ouverture » n'existe pas. ` +
      `Modes connus : ${MODES.join(', ')}.`,
  );
}
const lumiere = mode === 'lumiere';
if (photos && (!lumiere || photos.length !== ouvertures.length)) {
  throw new Error(
    `Le schéma « diametre-ouverture » attend une photographie par ouverture, ` +
      `et seulement en mode « lumiere ».`,
  );
}
/* L'axe du mode lumière va du plus grand trou au plus petit : l'ordre des
   disques doit suivre l'axe, quel que soit l'ordre reçu. La photographie suit
   son ouverture, d'où l'appariement avant le tri. */
const paires = ouvertures.map((o, i) => ({ ouverture: o, photo: photos?.[i] }));
const ordre = lumiere ? [...paires].sort((a, b) => a.ouverture - b.ouverture) : paires;
const mesures = ordre.map((p) => ({ ...p, mm: diametre(focale, p.ouverture) }));
const maximum = Math.max(...mesures.map((d) => d.mm));
const disques = mesures.map((d, i) => ({
  ...d,
  cx: 80 + i * (480 / (mesures.length - 1)),
  r: (d.mm / maximum) * 52,
}));
---
{lumiere
  ? <DisquesLumiere disques={disques} />
  : <DisquesDivision focale={focale} disques={disques} />}
