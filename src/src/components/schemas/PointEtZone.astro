---
/**
 * Mise au point et profondeur de champ, côte à côte.
 *
 * C'est la confusion la plus fréquente chez les débutants, et deux dessins
 * jumeaux la règlent mieux qu'un paragraphe : à gauche, on **déplace le point**
 * et l'épaisseur ne change pas ; à droite, on **change l'épaisseur** et le point
 * ne bouge pas.
 */
---
<svg viewBox="0 0 640 250" role="img" style="width:100%;height:auto"
     aria-label="À gauche, le point se déplace ; à droite, la zone s'épaissit autour d'un point fixe">
  <defs>
    <linearGradient id="pz-a" x1="0" x2="1">
      <stop offset="0" stop-color="var(--accent)" stop-opacity="0" />
      <stop offset="0.5" stop-color="var(--accent)" stop-opacity="0.4" />
      <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
    </linearGradient>
  </defs>

  <g>
    <text x="150" y="26" text-anchor="middle" font-size="15" font-weight="620" fill="var(--texte)">
      La mise au point
    </text>
    <text x="150" y="46" text-anchor="middle" font-size="13" fill="var(--texte-3)">où est le point</text>
    <line x1="30" y1="160" x2="270" y2="160" stroke="var(--trait)" />
    <rect x="66" y="86" width="60" height="74" fill="url(#pz-a)" />
    <line x1="96" y1="80" x2="96" y2="166" stroke="var(--texte)" stroke-width="2" />
    <rect x="186" y="86" width="60" height="74" fill="url(#pz-a)" opacity="0.35" />
    <line x1="216" y1="80" x2="216" y2="166" stroke="var(--texte-3)" stroke-width="2" stroke-dasharray="4 3" />
    <path d="M104 196 L208 196" stroke="var(--texte-2)" stroke-width="1.5" />
    <path d="M200 191 L208 196 L200 201 Z" fill="var(--texte-2)" />
    <text x="150" y="220" text-anchor="middle" font-size="13" fill="var(--texte-2)">le point se déplace</text>
    <text x="150" y="240" text-anchor="middle" font-size="13" fill="var(--accent)">l'épaisseur ne change pas</text>
  </g>

  <line x1="320" y1="20" x2="320" y2="240" stroke="var(--trait)" />

  <g>
    <text x="490" y="26" text-anchor="middle" font-size="15" font-weight="620" fill="var(--texte)">
      La profondeur de champ
    </text>
    <text x="490" y="46" text-anchor="middle" font-size="13" fill="var(--texte-3)">quelle épaisseur est nette</text>
    <line x1="370" y1="160" x2="610" y2="160" stroke="var(--trait)" />
    <rect x="466" y="86" width="48" height="74" fill="url(#pz-a)" />
    <rect x="406" y="86" width="168" height="74" fill="url(#pz-a)" opacity="0.45" />
    <line x1="490" y1="80" x2="490" y2="166" stroke="var(--texte)" stroke-width="2" />
    <text x="490" y="220" text-anchor="middle" font-size="13" fill="var(--texte-2)">le point ne bouge pas</text>
    <text x="490" y="240" text-anchor="middle" font-size="13" fill="var(--accent)">la zone s'épaissit autour</text>
  </g>
</svg>
