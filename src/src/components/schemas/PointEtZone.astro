---
/**
 * Mise au point et profondeur de champ, l'une au-dessus de l'autre.
 *
 * C'est la confusion la plus fréquente chez les débutants, et deux dessins
 * jumeaux la règlent mieux qu'un paragraphe : en haut, on **déplace le point**
 * et l'épaisseur ne change pas ; en bas, on **change l'épaisseur** et le point
 * ne bouge pas. Chaque ligne de sol part de vous (`pieces/Vous.astro`) : sans
 * ce repère, un point qui s'y déplace se lit comme un endroit arbitraire
 * plutôt que comme une distance depuis vous.
 *
 * Dessin compact : le panneau qui l'accueille (`point-ou-zone`, et sa reprise
 * en séance 3 sur `definir-une-intention`) laisse moins de hauteur que sa
 * largeur ne le suggère — vérifié à 1280×720, le point le plus serré. D'où
 * l'absence de flèche d'annotation : la paire de repères (plein / pointillé)
 * et la légende suffisent à dire que le point se déplace.
 */
import Vous from './pieces/Vous.astro';
---
<svg viewBox="0 0 300 236" role="img" style="width:100%;height:auto"
     aria-label="En haut, le point se déplace ; en bas, la zone s'épaissit autour d'un point fixe">
  <defs>
    <linearGradient id="pz-a" x1="0" x2="1">
      <stop offset="0" stop-color="var(--accent)" stop-opacity="0" />
      <stop offset="0.5" stop-color="var(--accent)" stop-opacity="0.4" />
      <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
    </linearGradient>
  </defs>

  <g>
    <text x="150" y="12" text-anchor="middle" font-size="12" font-weight="620" fill="var(--texte)">
      La mise au point
    </text>
    <text x="150" y="25" text-anchor="middle" font-size="10" fill="var(--texte-3)">où est le point</text>
    <line x1="24" y1="62" x2="280" y2="62" stroke="var(--trait)" />
    <Vous x={24} y={62} />
    <rect x="76" y="34" width="40" height="28" fill="url(#pz-a)" />
    <line x1="96" y1="30" x2="96" y2="68" stroke="var(--texte)" stroke-width="2" />
    <rect x="204" y="34" width="40" height="28" fill="url(#pz-a)" opacity="0.35" />
    <line x1="224" y1="30" x2="224" y2="68" stroke="var(--texte-3)" stroke-width="2" stroke-dasharray="4 3" />
    <text x="150" y="92" text-anchor="middle" font-size="10" fill="var(--texte-2)">le point se déplace</text>
    <text x="150" y="104" text-anchor="middle" font-size="10" fill="var(--accent)">l'épaisseur ne change pas</text>
  </g>

  <line x1="24" y1="117" x2="280" y2="117" stroke="var(--trait)" />

  <g>
    <text x="150" y="131" text-anchor="middle" font-size="12" font-weight="620" fill="var(--texte)">
      La profondeur de champ
    </text>
    <text x="150" y="144" text-anchor="middle" font-size="10" fill="var(--texte-3)">quelle épaisseur est nette</text>
    <line x1="24" y1="181" x2="280" y2="181" stroke="var(--trait)" />
    <Vous x={24} y={181} />
    <rect x="134" y="153" width="32" height="28" fill="url(#pz-a)" />
    <rect x="90" y="153" width="120" height="28" fill="url(#pz-a)" opacity="0.45" />
    <line x1="150" y1="149" x2="150" y2="187" stroke="var(--texte)" stroke-width="2" />
    <text x="150" y="211" text-anchor="middle" font-size="10" fill="var(--texte-2)">le point ne bouge pas</text>
    <text x="150" y="223" text-anchor="middle" font-size="10" fill="var(--accent)">la zone s'épaissit autour</text>
  </g>
</svg>
