---
/**
 * Les quatre leviers, dont **un seul** est un réglage.
 *
 * C'est le message à retenir du bloc, davantage que la mécanique de l'ouverture,
 * et le dessin le dit sans phrase : un levier en couleur d'accent, trois en
 * traits ordinaires, et l'étiquette « gratuit » sur les trois.
 */
const LEVIERS = [
  { titre: "L'ouverture", note: 'le réglage', reglage: true },
  { titre: 'Votre distance au sujet', note: 'vos pieds', reglage: false },
  { titre: 'La focale', note: 'votre zoom', reglage: false },
  { titre: 'La distance sujet → fond', note: 'les pieds du sujet', reglage: false },
];
---
<svg viewBox="0 0 640 260" role="img" style="width:100%;height:auto"
     aria-label="Quatre leviers contrôlent le flou ; un seul est un réglage d'appareil">
  {LEVIERS.map((levier, i) => {
    const y = 12 + i * 60;
    const couleur = levier.reglage ? 'var(--accent)' : 'var(--trait-fort)';
    return (
      <g>
        <rect x="8" y={y} width="624" height="48" rx="8"
              fill={levier.reglage ? 'color-mix(in oklab, var(--accent) 12%, transparent)' : 'transparent'}
              stroke={couleur} stroke-width={levier.reglage ? 2 : 1} />
        <circle cx="40" cy={y + 24} r="14" fill={couleur} />
        <text x="40" y={y + 29} text-anchor="middle" font-size="15" font-weight="700"
              fill={levier.reglage ? 'var(--sur-accent)' : 'var(--fond)'}>{i + 1}</text>
        <text x="70" y={y + 29} font-size="17" fill="var(--texte)">{levier.titre}</text>
        <text x="624" y={y + 29} text-anchor="end" font-size="13"
              fill={levier.reglage ? 'var(--accent)' : 'var(--texte-3)'}
              letter-spacing="1.4">
          {levier.reglage ? 'UN RÉGLAGE' : 'GRATUIT'}
        </text>
      </g>
    );
  })}
  <text x="320" y="254" text-anchor="middle" font-size="14" fill="var(--accent)">
    Trois sur quatre ne demandent aucun menu.
  </text>
</svg>
