---
/**
 * Le sommaire d'une leçon.
 *
 * Sur le projecteur, c'est le point de départ de la soirée. Sur un téléphone,
 * c'est la table des matières de la relecture — d'où la liste complète des blocs
 * et de leurs écrans plutôt qu'un simple bouton « commencer ».
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { lien } from '../../../lib/lien';
import { typo } from '../../../lib/typo';
import { aplatir, nombreEtats } from '../../../lib/lecon';
import { dateLisible } from '../../../lib/calendrier';
import '../../../styles/carrefour.css';

export const getStaticPaths = (async () => {
  const lecons = await getCollection('lecons');
  return lecons.map((entree) => ({
    params: { numero: String(entree.data.numero) },
    props: { lecon: entree.data },
  }));
}) satisfies GetStaticPaths;

const { lecon } = Astro.props;
const arrets = aplatir(lecon);
const premier = arrets[0]!;
const date = dateLisible(lecon.numero);

const GENRES: Record<string, string> = {
  panneau: 'concept',
  demonstration: 'démonstration',
  interactif: 'interactif',
  repere: 'repère',
  'appareil-en-main': 'appareil en main',
};
---

<Base titre={`Séance ${lecon.numero} — ${lecon.titre}`} description={lecon.filConducteur}>
  <div class="page" id="contenu">
    <nav class="fil">
      <a href={lien('/')}>Premiers clics</a> <span>·</span>
      <span>{typo(`Séance ${lecon.numero}`)}</span>
    </nav>

    <header class="entete-site">
      <p class="surtitre">{typo(`Séance ${lecon.numero}${date ? ` · ${date}` : ''}`)}</p>
      <h1 set:html={typo(lecon.titre)} />
      <p class="chapeau" set:html={typo(lecon.filConducteur)} />
    </header>

    {lecon.question && (
      <p
        style="border-left:3px solid var(--accent);background:var(--fond-2);padding:0.9rem 1.1rem;border-radius:0 var(--rayon) var(--rayon) 0;margin-bottom:1.8rem"
        set:html={typo(`Cette soirée traite une seule question : ${lecon.question}`)}
      />
    )}

    <p style="margin-bottom:2rem">
      <a class="carte" style="display:inline-block" href={lien(premier.chemin)}>
        <span class="etiquette">Commencer</span>
        <h3 set:html={typo(`${lecon.blocs.length} blocs · ${arrets.length} écrans`)} />
        <p>Les flèches pour naviguer, <code>i</code> pour l'index, <code>f</code> pour le plein écran.</p>
      </a>
    </p>

    {lecon.blocs.map((bloc, i) => (
      <section class="section-carrefour">
        <h2>
          <span style="color:var(--accent)">{i + 1}.</span>
          <span set:html={typo(bloc.titre)} />
        </h2>
        {bloc.resume && (
          <p style="color:var(--texte-2);margin-bottom:0.8rem" set:html={typo(bloc.resume)} />
        )}
        <ul class="liste-simple">
          {bloc.ecrans.map((ecran) => {
            const etats = nombreEtats(ecran);
            return (
              <li>
                <a href={lien(`/lecons/${lecon.numero}/${bloc.id}/${ecran.id}`)}>
                  <span style="font-size:var(--t-etiquette);letter-spacing:0.1em;text-transform:uppercase;color:var(--texte-3);display:block">
                    {GENRES[ecran.genre]}
                    {etats > 1 && typo(` · ${etats} états`)}
                  </span>
                  <span set:html={typo(ecran.titre ?? (ecran as any).claim ?? bloc.titre)} />
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}

    <footer class="pied-site">
      <p set:html={typo(
        'Les explications de cette séance restent en ligne. C’est ici qu’il faut revenir dans trois semaines, quand la question se posera pour de vrai.',
      )} />
    </footer>
  </div>
</Base>
