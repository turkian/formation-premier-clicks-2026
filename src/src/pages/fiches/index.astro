---
/**
 * L'index des fiches.
 *
 * Il se construit depuis la collection : une fiche ajoutée y apparaît sans
 * qu'on touche à cette page. C'est l'exigence d'extensibilité, tenue par la
 * structure plutôt que par la discipline.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { lien } from '../../lib/lien';
import { typo } from '../../lib/typo';
import '../../styles/carrefour.css';

const fiches = (await getCollection('fiches')).sort(
  (a, b) => a.data.rang - b.data.rang || a.data.titre.localeCompare(b.data.titre, 'fr'),
);
---

<Base
  titre="Fiches de référence"
  description="Des fiches d'une page, à imprimer sur une feuille ou à consulter sur le téléphone en photographiant."
>
  <div class="page" id="contenu">
    <nav class="fil">
      <a href={lien('/')}>Premiers clics</a> <span>·</span> <span>Fiches</span>
    </nav>

    <header class="entete-site">
      <p class="surtitre">À garder</p>
      <h1>Fiches de référence</h1>
      <p class="chapeau" set:html={typo(
        'Chacune tient sur une page. Imprimez celles qui vous servent, ou gardez-les ouvertes sur votre téléphone pendant que vous photographiez.',
      )} />
    </header>

    <section class="section-carrefour">
      <div class="grille">
        {fiches.map((fiche) => (
          <a class="carte" href={lien(`/fiches/${fiche.id}`)}>
            <span class="etiquette">
              {fiche.data.seance ? typo(`Séance ${fiche.data.seance}`) : 'Référence'}
            </span>
            <h3 set:html={typo(fiche.data.titre)} />
            {fiche.data.sousTitre && <p set:html={typo(fiche.data.sousTitre)} />}
          </a>
        ))}
      </div>
    </section>

    <footer class="pied-site">
      <p set:html={typo(
        'Pour imprimer : ouvrez la fiche, puis imprimez la page. Elle est conçue pour tenir sur une seule feuille — laissez les marges de votre imprimante par défaut.',
      )} />
    </footer>
  </div>
</Base>
